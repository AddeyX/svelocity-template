{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"types": ["vite/client"]
	},
	"include": ["convex/**/*", "vitest.config.ts"]
}
