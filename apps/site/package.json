{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5174 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 4174 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"gen": "wrangler types",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@stack/backend": "workspace:*",
		"@stack/tokens": "workspace:*",
		"convex": "1.46.0",
		"convex-svelte": "^0.14.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "7.2.8",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "4.3.0",
		"svelte": "5.57.2",
		"svelte-check": "4.4.8",
		"tailwindcss": "4.3.0",
		"typescript": "^6.0.2",
		"vite": "8.0.16",
		"vitest": "4.1.10",
		"wrangler": "4.115.0"
	}
}
