{
	"name": "mobile",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5176 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 4176 --strictPort",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run --config vitest.config.ts",
		"sync": "pnpm build && cap sync",
		"open:ios": "cap open ios",
		"open:android": "cap open android",
		"add:ios": "pnpm build && cap add ios",
		"add:android": "pnpm build && cap add android"
	},
	"dependencies": {
		"@capacitor/app": "^8.0.0",
		"@capacitor/core": "^8.0.0",
		"@capacitor/splash-screen": "^8.0.0",
		"@capacitor/status-bar": "^8.0.0",
		"@stack/backend": "workspace:*",
		"@stack/tokens": "workspace:*",
		"bits-ui": "^2.18.1",
		"convex": "1.46.0",
		"convex-svelte": "^0.14.0"
	},
	"devDependencies": {
		"@capacitor/android": "^8.0.0",
		"@capacitor/cli": "^8.0.0",
		"@capacitor/ios": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "4.3.0",
		"svelte": "5.56.5",
		"svelte-check": "4.4.8",
		"tailwindcss": "4.3.0",
		"typescript": "^6.0.2",
		"vite": "8.0.16",
		"vitest": "4.1.10"
	}
}
